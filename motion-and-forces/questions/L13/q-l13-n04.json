  "stem": {
    "en": "A footballer kicks a penalty. The ball, of mass 0.4 kg, starts from rest and leaves the foot at 108 km/h. The force on the ball is 800 N. How long are the foot and the ball in contact, in seconds?"
  },
  "expectedValue": 0.015,
  "tolerance": 0.001,
  "unit": "s",
  "explanation": {
    "en": "108 km/h = 30 m/s. a = F / m = 800 N / 0.4 kg = 2000 m/s². From v = u + at: t = (30 m/s - 0) / 2000 m/s² = 0.015 s."
  },
  "hints": [
    {
      "en": "Change 108 km/h into m/s. Find a = F / m, then t from v = u + at."
    }
  ],
