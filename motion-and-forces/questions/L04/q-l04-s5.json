    "en": "A car starts from rest. Its velocity reaches 24 m/s in 6 s. What is its average acceleration, in m/s²?"
  },
  "expectedValue": 4,
  "tolerance": 0.1,
  "unit": "m/s²",
  "explanation": {
    "en": "a = (v - u) / t = (24 m/s - 0 m/s) / 6 s = 4 m/s²."
  },
  "hints": [
    {
      "en": "Average acceleration = (final velocity - initial velocity) / time interval."
