  "stem": {
    "en": "Which pair is correctly placed, with the first part present in plant cells and the second part absent in animal cells?"
  },
  "options": [
    {
      "id": "a",
      "text": {
        "en": "Leucoplast, cell wall"
      },
      "isCorrect": true,
      "feedback": {
        "en": "Yes. Plant cells have leucoplasts, and animal cells have no cell wall."
      }
    },
    {
      "id": "b",
      "text": {
        "en": "Mitochondria, ribosome"
      },
      "isCorrect": false,
      "feedback": {
        "en": "Animal cells do have ribosomes."
      }
    },
    {
      "id": "c",
      "text": {
        "en": "Cell wall, Golgi apparatus"
      },
      "isCorrect": false,
      "feedback": {
        "en": "Animal cells do have a Golgi apparatus."
      }
    },
    {
      "id": "d",
      "text": {
        "en": "Lysosome, endoplasmic reticulum"
      },
      "isCorrect": false,
      "feedback": {
        "en": "Animal cells do have endoplasmic reticulum."
      }
    }
  ],
  "correctOptionId": "a",
  "explanation": {
    "en": "Check the second part of each pair first. Of these, only the cell wall is absent from animal cells."
  },
