  "stem": {
    "en": "A sound travels 1720 m through air. How long does it take when sound travels at 344 m/s, and when it travels at 331 m/s?"
  },
  "options": [
    {
      "id": "a",
      "text": {
        "en": "5.0 s and about 5.2 s"
      },
      "isCorrect": true
    },
    {
      "id": "b",
      "text": {
        "en": "5.2 s and 5.0 s"
      },
      "isCorrect": false
    },
    {
      "id": "c",
